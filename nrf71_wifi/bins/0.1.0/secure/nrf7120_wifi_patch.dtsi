/ {
	soc {
		lmac_rom_patch_addr: memory@1f1860 {
			reg = <0x1f1860 24692>;
		};

		umac_rom_patch_addr: memory@1f78e0 {
			reg = <0x1f78e0 38674>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
