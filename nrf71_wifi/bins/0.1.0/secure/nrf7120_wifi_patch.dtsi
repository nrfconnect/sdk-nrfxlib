/ {
	soc {
		lmac_rom_patch_addr: memory@1f21c0 {
			reg = <0x1f21c0 23384>;
		};

		umac_rom_patch_addr: memory@1f7d20 {
			reg = <0x1f7d20 37594>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
