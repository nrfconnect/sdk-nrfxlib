/ {
	soc {
		lmac_rom_patch_addr: memory@1f2410 {
			reg = <0x1f2410 23384>;
		};

		umac_rom_patch_addr: memory@1f7f70 {
			reg = <0x1f7f70 37002>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
