#ifdef USE_NON_SECURE_ADDRESS_MAP
#include "../0.1.0_ns/nrf7120_wifi_patch.dtsi"
#else

/ {
	soc {
		lmac_rom_patch_addr: memory@1ecfe0 {
			reg = <0x1ecfe0 22444>;
		};

		umac_rom_patch_addr: memory@1f2790 {
			reg = <0x1f2790 30484>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};

#endif /* USE_NON_SECURE_ADDRESS_MAP */
