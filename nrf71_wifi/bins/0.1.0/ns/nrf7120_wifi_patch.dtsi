/ {
	soc {
		lmac_rom_patch_addr: memory@3dc1c0 {
			reg = <0x3dc1c0 23384>;
		};

		umac_rom_patch_addr: memory@3e1d20 {
			reg = <0x3e1d20 37594>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
