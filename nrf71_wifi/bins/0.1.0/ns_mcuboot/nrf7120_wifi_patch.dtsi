/ {
	soc {
		lmac_rom_patch_addr: memory@1e1c20 {
			reg = <0x1e1c20 23384>;
		};

		umac_rom_patch_addr: memory@1e7780 {
			reg = <0x1e7780 38014>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
