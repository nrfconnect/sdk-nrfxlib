/ {
	soc {
		lmac_rom_patch_addr: memory@1e1dc0 {
			reg = <0x1e1dc0 23384>;
		};

		umac_rom_patch_addr: memory@1e7920 {
			reg = <0x1e7920 37594>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
