/ {
	soc {
		lmac_rom_patch_addr: memory@1eac20 {
			reg = <0x1eac20 23384>;
		};

		umac_rom_patch_addr: memory@1f0780 {
			reg = <0x1f0780 38014>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
