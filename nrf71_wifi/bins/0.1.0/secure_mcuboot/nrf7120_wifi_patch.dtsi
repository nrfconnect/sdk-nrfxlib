/ {
	soc {
		lmac_rom_patch_addr: memory@1eadc0 {
			reg = <0x1eadc0 23384>;
		};

		umac_rom_patch_addr: memory@1f0920 {
			reg = <0x1f0920 37594>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
