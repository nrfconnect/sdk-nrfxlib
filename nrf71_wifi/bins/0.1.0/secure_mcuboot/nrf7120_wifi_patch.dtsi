/ {
	soc {
		lmac_rom_patch_addr: memory@1eb160 {
			reg = <0x1eb160 23308>;
		};

		umac_rom_patch_addr: memory@1f0c70 {
			reg = <0x1f0c70 36746>;
		};
	};
};

&wicr {
	firmware-lmacrompatchaddr = <&lmac_rom_patch_addr>;
	firmware-umacrompatchaddr = <&umac_rom_patch_addr>;
};
