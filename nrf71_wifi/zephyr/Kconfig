if NRF71_WIFI

config NRF71_WIFI_PATCH
	bool "Include nRF7120 Wi-Fi ROM patches in the application image"
	depends on !IS_BOOTLOADER_IMG
	help
	  The Wi-Fi ROM patches are placed at fixed internal NVM addresses
	  required by the Wi-Fi Core. When MCUboot is enabled, the merged image
	  including the application and the Wi-Fi ROM patches is signed and
	  delivered as part of standard firmware updates.

	  RF parameters bundled with the selected patch version are included
	  in the same image.

	  Note: The regular ELF-derived artifacts do not contain Wi-Fi patch
	  data. Only the merged output used for programming and signing
	  includes the patches.

if NRF71_WIFI_PATCH

choice NRF71_WIFI_PATCH_VERSION
	prompt "nRF7120 Wi-Fi ROM patch version"
	default NRF71_WIFI_PATCH_VERSION_0_1_0
	help
	  Out-of-tree modules can add further choice entries with matching
	  NRF71_WIFI_PATCH_MANIFEST_FILE and NRF71_WIFI_PATCH_DTSI_FILE values.

config NRF71_WIFI_PATCH_VERSION_0_1_0
	bool "0.1.0"

endchoice

config NRF71_WIFI_PATCH_MANIFEST_FILE
	string
	default "$(ZEPHYR_NRFXLIB_MODULE_DIR)/nrf71_wifi/bins/0.1.0/manifest.json" if NRF71_WIFI_PATCH_VERSION_0_1_0
	help
	  Specifies the path to the Wi-Fi ROM patch manifest file.

config NRF71_WIFI_PATCH_DTSI_FILE
	string
	default "$(ZEPHYR_NRFXLIB_MODULE_DIR)/nrf71_wifi/bins/0.1.0/nrf7120_wifi_patch.dtsi" if NRF71_WIFI_PATCH_VERSION_0_1_0
	help
	  Specifies the path to the Wi-Fi ROM patch devicetree overlay file.

endif # NRF71_WIFI_PATCH

endif # NRF71_WIFI
